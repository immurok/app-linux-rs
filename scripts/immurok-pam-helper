#!/bin/bash
#
# immurok PAM 配置助手 — 通过 pkexec 以 root 运行
#
# 用法: immurok-pam-helper add <service> [service...]
#        immurok-pam-helper remove <service> [service...]
#        immurok-pam-helper migrate-daemon <user>
#        immurok-pam-helper purge-daemon [--keep-state|--purge-state]
#
# service: sudo | polkit-1
#          gdm-password —— 仅 remove 用：模块对它直接 PAM_IGNORE
#          （pam/fp_policy.h），不再安装，但要能清掉旧版留下的那行。
#

PAM_LINE="auth        sufficient    pam_immurok.so"

PAM_D="${IMMUROK_PAM_D:-/etc/pam.d}"

# 厂商 PAM 目录。PAM 1.5 的查找顺序是 /etc/pam.d 优先、缺失才落到
# /usr/lib/pam.d，于是像 Arch 的 gdm 这类包把配置整体搬去了 /usr/lib，
# /etc 下那份只在用户改过时才存在 —— 而且包升级时 pacman 会把它留成
# .pacsave，于是一次系统升级就能让「登录屏」那行凭空消失。只认 /etc 的
# 话在这些发行版上永远装不上（旧版就是直接报 FILE_NOT_FOUND），正确做法
# 是把厂商那份抄进 /etc 当 override，再往副本里插行。
PAM_VENDOR_D="${IMMUROK_PAM_VENDOR_D:-/usr/lib/pam.d}"

# 我们自己创建的文件（polkit-1 模板、厂商副本）带这个标记，remove 时据此
# 整份删掉而不是只删行 —— 留着一份过期的 /etc 副本会一直盖住厂商文件，
# 发行版后续对该服务 PAM 栈的更新就再也到不了这台机器。
IMMUROK_MARKER="Created by immurok"

# 选择 polkit-1 模板的 include 目标。按文件是否真实存在来判断，顺序：
#   - password-auth —— Fedora / RHEL（两份都有，非控制台服务按惯例走这份，
#     已在 Fedora 44 验证）
#   - system-auth   —— Arch、openSUSE 等（Arch **没有** password-auth）
#   - common-auth   —— Debian / Ubuntu
# 三个都没有就返回失败，由调用方报错。绝不能 fallback 到某个猜的名字：
# include 指向不存在的文件时 PAM 只会报 "unable to open config"，auth 和
# account 两条栈一起打不开 —— 指纹明明 Approved，polkit-agent-helper 的
# pam_acct_mgmt() 依然失败，polkit 把它当认证失败后反复弹框，变成死循环
# （旧实现 fallback 回 password-auth，Arch 上实测就是这个下场）。
pam_include_target() {
    if [ -n "${IMMUROK_PAM_INCLUDE_TARGET:-}" ]; then
        echo "$IMMUROK_PAM_INCLUDE_TARGET"; return 0
    fi
    local candidate
    for candidate in password-auth system-auth common-auth; do
        [ -f "$PAM_D/$candidate" ] && { echo "$candidate"; return 0; }
    done
    return 1
}

# polkit-1 在 /etc 和厂商目录都没有文件时的兜底模板。只在真要新建时调用，
# 这样 remove / add sudo 不会被 include 目标探测失败牵连。
polkit_template() {
    local target
    target=$(pam_include_target) || return 1
    printf '#%%PAM-1.0\n# %s\n' "$IMMUROK_MARKER"
    printf 'auth        sufficient    pam_immurok.so timeout=10\n'
    local stack
    for stack in auth account password session; do
        printf '%-11s include       %s\n' "$stack" "$target"
    done
}

# ── 坏配置自愈 ───────────────────────────────────────────────
# 列出一份 PAM 配置里所有 include / substack 的目标，含 Debian 的 @include。
pam_include_targets() {
    sed -nE \
        -e 's/^[[:space:]]*(auth|account|password|session)[[:space:]]+(include|substack)[[:space:]]+([^[:space:]]+).*/\3/p' \
        -e 's/^[[:space:]]*@include[[:space:]]+([^[:space:]]+).*/\1/p' \
        "$1" | sort -u
}

# 配置坏不坏：有 include 目标在 /etc/pam.d 和厂商目录里都找不到就算坏，
# 打印第一个找不到的目标并返回 0。PAM 的查找顺序是 /etc 优先、缺失才落到
# /usr/lib/pam.d，所以两边都没有才算真的打不开。
#
# 为什么要专门治这种坏法：include 指向不存在的文件时 PAM 只报
# "unable to open config"，auth 和 account 两条栈会一起打不开 —— 指纹
# Approved 了 pam_acct_mgmt() 依然失败，polkit 当成认证失败反复弹框，变成
# 死循环。0.9.1–0.9.3 在 Arch 上就是这个下场（旧探测 fallback 到 Arch 并不
# 存在的 password-auth），而那份坏文件里 pam_immurok 行是在的，于是
# add 只会回 ALREADY_PRESENT、GUI 也照样显示已安装，光升级治不好。
pam_config_broken() {
    local file="$1" target
    for target in $(pam_include_targets "$file"); do
        [ -f "$PAM_D/$target" ] && continue
        [ -f "$PAM_VENDOR_D/$target" ] && continue
        echo "$target"; return 0
    done
    return 1
}

# ── PAM 模块目录检测 ─────────────────────────────────────────
pam_module_dir() {
    # 允许测试通过 IMMUROK_PAM_MODDIR 覆盖，默认探测真实路径
    [ -n "${IMMUROK_PAM_MODDIR:-}" ] && echo "$IMMUROK_PAM_MODDIR" && return
    for d in /usr/lib64/security /lib/aarch64-linux-gnu/security \
             /lib/x86_64-linux-gnu/security /lib/security; do
        [ -d "$d" ] && echo "$d" && return
    done
    echo "/usr/lib/security"
}

check_module() {
    [ "${IMMUROK_SKIP_MODULE_CHECK:-}" = "1" ] && return
    PAM_DIR=$(pam_module_dir)
    [ ! -f "$PAM_DIR/pam_immurok.so" ] && return 1
    return 0
}

# ── 操作 ─────────────────────────────────────────────────────
# ── 特权分离：把 daemon 从用户级搬到专用系统用户 ──────────────
#
# 全部 root 步骤集中在这里，Makefile 与 TUI 调用同一份实现。用户级的那
# 一半（停掉 systemctl --user 单元）也放这里 —— 顺序很关键：必须先停旧
# daemon 再起新的，否则两个进程会抢同一条 GATT 通道。
#
# 下面的变量可被覆盖，test-migrate-daemon.sh 靠它们在非 root 下跑完整流程。
DAEMON_USER="${IMMUROK_DAEMON_USER:-immurok}"
STATE_DIR="${IMMUROK_STATE_DIR:-/var/lib/immurok}"
SYSTEM_UNIT="${IMMUROK_SYSTEM_UNIT:-/etc/systemd/system/immurok-daemon.service}"
LEGACY_OVERRIDES="${IMMUROK_LEGACY_OVERRIDES:-/etc/systemd/system/polkit.service.d/immurok.conf /etc/systemd/system/polkit-agent-helper@.service.d/immurok.conf}"
# 只搬 daemon 自己拥有的状态。fwupdate/ 缓存归 CLI（用户身份下载后经
# socket 推给 daemon），markers/ 与 logs.txt 是瞬时数据，都留在原地。
MIGRATE_FILES="pairing.json settings.json ssh_keys.json key_names.json keystore_digests.json"

run_systemctl() {
    [ "${IMMUROK_SKIP_SYSTEMCTL:-}" = "1" ] && return 0
    systemctl "$@"
}

# 以目标用户身份读文件。不用 root 直接 cat：源文件在用户可写的目录里，
# 换成软链就能诱导 root 把别的文件复制进 STATE_DIR。以用户身份读，最坏
# 也只是读到他本来就能读的东西。
read_as_user() {
    local user="$1" path="$2"
    # 已经是本人（非 root 手动迁移或跑测试）就直接读，没有权可降。
    if [ "$(id -u)" -ne 0 ]; then
        cat "$path" 2>/dev/null
        return
    fi
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$user" -- cat "$path" 2>/dev/null
    else
        su -s /bin/sh -c "cat $(printf '%q' "$path")" "$user" 2>/dev/null
    fi
}

ensure_daemon_user() {
    [ "${IMMUROK_SKIP_USERADD:-}" = "1" ] && { echo "OK:USER_SKIPPED"; return 0; }
    if getent passwd "$DAEMON_USER" >/dev/null 2>&1; then
        echo "OK:USER_EXISTS($DAEMON_USER)"
    else
        local shell=""
        for c in /usr/sbin/nologin /sbin/nologin /usr/bin/nologin /bin/false; do
            [ -x "$c" ] && shell="$c" && break
        done
        getent group "$DAEMON_USER" >/dev/null 2>&1 || groupadd --system "$DAEMON_USER" || {
            echo "ERROR:GROUPADD_FAILED"; return 1; }
        useradd --system --no-create-home -g "$DAEMON_USER" \
                ${shell:+--shell "$shell"} "$DAEMON_USER" || {
            echo "ERROR:USERADD_FAILED"; return 1; }
        echo "OK:USER_CREATED($DAEMON_USER)"
    fi
    # BlueZ 授权来自我们自带的 D-Bus policy；有些发行版的 bluetooth.conf
    # 另外按组放行，两条都占上更稳。组不存在就跳过。
    if getent group bluetooth >/dev/null 2>&1; then
        usermod -aG bluetooth "$DAEMON_USER" 2>/dev/null \
            && echo "OK:GROUP_BLUETOOTH" || echo "OK:GROUP_BLUETOOTH_SKIPPED"
    fi
}

ensure_state_dir() {
    mkdir -p "$STATE_DIR" || { echo "ERROR:STATE_DIR_FAILED"; return 1; }
    chmod 700 "$STATE_DIR"
    [ "${IMMUROK_SKIP_USERADD:-}" = "1" ] || chown "$DAEMON_USER:$DAEMON_USER" "$STATE_DIR"
    echo "OK:STATE_DIR($STATE_DIR)"
}

# 记下设备属主 uid。daemon 用它拒绝「同机另一个账号借你的指纹提权」——
# socket 现在是全机一个，AUTH 里的 user 字段必须校验。已存在则不覆盖。
record_owner() {
    local user="$1" uid path="$STATE_DIR/owner"
    uid=$(id -u "$user" 2>/dev/null) || { echo "ERROR:NO_UID($user)"; return 0; }
    if [ -e "$path" ]; then echo "OK:OWNER_EXISTS($(cat "$path" 2>/dev/null))"; return 0; fi
    echo "$uid" > "$path"
    chmod 600 "$path"
    [ "${IMMUROK_SKIP_USERADD:-}" = "1" ] || chown "$DAEMON_USER:$DAEMON_USER" "$path"
    echo "OK:OWNER_RECORDED($uid)"
}

migrate_one_file() {
    local user="$1" home="$2" name="$3"
    local src="$home/.immurok/$name" dst="$STATE_DIR/$name"

    if [ -e "$dst" ]; then echo "OK:ALREADY_MIGRATED($name)"; return 0; fi
    if [ -L "$src" ]; then echo "ERROR:SYMLINK_REFUSED($name)"; return 0; fi
    if [ ! -f "$src" ]; then echo "OK:ABSENT($name)"; return 0; fi

    local tmp="$dst.migrating"
    if ! read_as_user "$user" "$src" > "$tmp"; then
        rm -f "$tmp"; echo "ERROR:READ_FAILED($name)"; return 0
    fi
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"; echo "ERROR:EMPTY_SOURCE($name)"; return 0
    fi
    chmod 600 "$tmp"
    [ "${IMMUROK_SKIP_USERADD:-}" = "1" ] || chown "$DAEMON_USER:$DAEMON_USER" "$tmp"
    mv -f "$tmp" "$dst"
    # 原件改名而不是删除：迁移出问题时用户还能自己搬回去。
    mv -f "$src" "$src.migrated"
    echo "OK:MIGRATED($name)"
}

stop_user_daemon() {
    local user="$1" uid
    uid=$(id -u "$user" 2>/dev/null) || { echo "ERROR:NO_UID($user)"; return 0; }
    [ "${IMMUROK_SKIP_SYSTEMCTL:-}" = "1" ] && { echo "OK:USER_UNIT_SKIPPED"; return 0; }
    # systemctl --user 要目标用户的会话总线，所以带着 XDG_RUNTIME_DIR 切过去。
    # 用户没登录时这步失败，没关系：那就没有旧 daemon 在跑。
    if runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/$uid" \
            systemctl --user disable --now immurok-daemon.service >/dev/null 2>&1; then
        echo "OK:USER_UNIT_STOPPED"
    else
        echo "OK:USER_UNIT_ABSENT"
    fi
}

drop_legacy_overrides() {
    # 这两个 override 是「socket 在 /run/user/<uid>」时代给 polkit 开的口子
    # （ProtectHome=yes 会把 /run/user 整个挡掉）。socket 搬到 /run/immurok
    # 之后不再需要，删掉即可把 polkit 沙箱还原成发行版默认。
    #
    # 故意不 restart polkit：我们自己很可能正跑在 pkexec 里，而残留的
    # override 在下次 polkit 重启前是无害的。
    local removed=0
    for f in $LEGACY_OVERRIDES; do
        if [ -f "$f" ]; then
            rm -f "$f" && removed=1
            rmdir "$(dirname "$f")" 2>/dev/null
        fi
    done
    if [ "$removed" = "1" ]; then echo "OK:LEGACY_OVERRIDES_REMOVED"; else echo "OK:NO_LEGACY_OVERRIDES"; fi
}

start_system_daemon() {
    if [ ! -f "$SYSTEM_UNIT" ]; then echo "ERROR:UNIT_NOT_INSTALLED"; return 1; fi
    run_systemctl daemon-reload
    run_systemctl enable immurok-daemon.service >/dev/null 2>&1
    # restart 而不是 --now：--now 对已在运行的服务是空操作，重装新二进制
    # 时旧进程会一直跑着，install 就不是升级路径了。
    if run_systemctl restart immurok-daemon.service >/dev/null 2>&1; then
        echo "OK:SYSTEM_UNIT_STARTED"
    else
        echo "ERROR:SYSTEM_UNIT_START_FAILED"
        return 1
    fi
}

migrate_daemon() {
    local user="${1:-}"
    [ -z "$user" ] && { echo "ERROR:NO_USER"; return 1; }
    # IMMUROK_HOME 是测试钩子（同 IMMUROK_PAM_D），正常路径查 passwd。
    local home="${IMMUROK_HOME:-}"
    [ -n "$home" ] || home=$(getent passwd "$user" | cut -d: -f6)
    [ -z "$home" ] && { echo "ERROR:UNKNOWN_USER($user)"; return 1; }

    stop_user_daemon "$user"
    ensure_daemon_user || return 1
    ensure_state_dir || return 1
    record_owner "$user"
    for f in $MIGRATE_FILES; do
        migrate_one_file "$user" "$home" "$f"
    done
    drop_legacy_overrides
    start_system_daemon || return 1
    echo "OK:MIGRATED"
}

purge_daemon() {
    local mode="${1:---keep-state}"
    if [ "${IMMUROK_SKIP_SYSTEMCTL:-}" != "1" ]; then
        systemctl disable --now immurok-daemon.service >/dev/null 2>&1
        rm -f "$SYSTEM_UNIT"
        systemctl daemon-reload
    fi
    echo "OK:UNIT_REMOVED"

    if [ "$mode" = "--purge-state" ]; then
        rm -rf "$STATE_DIR"
        echo "OK:STATE_PURGED($STATE_DIR)"
    else
        echo "OK:STATE_KEPT($STATE_DIR)"
    fi

    if [ "${IMMUROK_SKIP_USERADD:-}" != "1" ] && getent passwd "$DAEMON_USER" >/dev/null 2>&1; then
        if userdel "$DAEMON_USER" >/dev/null 2>&1; then
            echo "OK:USER_REMOVED($DAEMON_USER)"
        else
            echo "ERROR:USERDEL_FAILED($DAEMON_USER)"
        fi
        getent group "$DAEMON_USER" >/dev/null 2>&1 && groupdel "$DAEMON_USER" >/dev/null 2>&1
    else
        echo "OK:NO_USER($DAEMON_USER)"
    fi
}

ACTION="$1"; shift || true

case "$ACTION" in
    migrate-daemon) migrate_daemon "${1:-}"; exit $? ;;
    purge-daemon)   purge_daemon "${1:---keep-state}"; exit $? ;;
esac

process_one() {
    local SERVICE="$1"
    case "$SERVICE" in
        sudo|gdm-password|polkit-1) ;;
        *) echo "ERROR:INVALID_SERVICE($SERVICE)"; return 0 ;;
    esac
    local PAM_FILE="$PAM_D/$SERVICE"

    case "$ACTION" in
        add)
            check_module || { echo "ERROR:MODULE_NOT_INSTALLED($SERVICE)"; return 0; }
            # 自愈：我们自己建的文件（polkit-1 模板 / 厂商副本）如果 include
            # 指向两边都不存在的文件，整份重建 —— 否则下面会回
            # ALREADY_PRESENT，坏配置永远留着（见 pam_config_broken 的说明）。
            # 只动带标记的文件：用户自己维护的那份轮不到我们重建。
            local repaired=0
            if [ -f "$PAM_FILE" ] && grep -q "$IMMUROK_MARKER" "$PAM_FILE" \
               && pam_config_broken "$PAM_FILE" >/dev/null; then
                # 确认重建得出来再删。删完建不起来的话这个服务就一份配置都没
                # 有了，PAM 会落到 /etc/pam.d/other —— 那比留着坏文件更糟。
                if [ -f "$PAM_VENDOR_D/$SERVICE" ] \
                   || { [ "$SERVICE" = "polkit-1" ] && pam_include_target >/dev/null; }; then
                    rm -f "$PAM_FILE"; repaired=1
                else
                    echo "ERROR:CANNOT_REPAIR($SERVICE)"; return 0
                fi
            fi
            # /etc 里没有，但厂商目录有：抄一份当 override 再插行。
            # 这一步必须排在 polkit-1 模板之前：Arch 的 polkit 包自带
            # /usr/lib/pam.d/polkit-1（include system-auth），发行版自己写的
            # include 目标一定比我们猜的准，照抄就不会猜错。
            local from_vendor=0
            if [ ! -f "$PAM_FILE" ] && [ -f "$PAM_VENDOR_D/$SERVICE" ]; then
                cp "$PAM_VENDOR_D/$SERVICE" "$PAM_FILE" || {
                    echo "ERROR:VENDOR_COPY_FAILED($SERVICE)"; return 0; }
                # 标记追加在末尾：厂商内容（含首行 #%PAM-1.0）保持原样。
                printf '# %s: copy of %s, so the immurok auth line could be added.\n# Removing immurok deletes this file and restores the vendor config.\n' \
                    "$IMMUROK_MARKER" "$PAM_VENDOR_D/$SERVICE" >> "$PAM_FILE"
                chmod 644 "$PAM_FILE"
                from_vendor=1
            fi
            # 厂商那份也没有：polkit-1 允许用模板兜底（不少发行版本来就不带
            # 这个文件）。探测不到 include 目标时宁可报错，也不留坏配置。
            if [ "$SERVICE" = "polkit-1" ] && [ ! -f "$PAM_FILE" ]; then
                local template
                template=$(polkit_template) || {
                    echo "ERROR:NO_PAM_INCLUDE_TARGET($SERVICE)"; return 0; }
                printf '%s\n' "$template" > "$PAM_FILE"; chmod 644 "$PAM_FILE"
                if [ "$repaired" = "1" ]; then echo "OK:REPAIRED($SERVICE)"
                else echo "OK:CREATED($SERVICE)"; fi
                return 0
            fi
            if [ ! -f "$PAM_FILE" ]; then echo "ERROR:FILE_NOT_FOUND($SERVICE)"; return 0; fi
            if grep -q 'pam_immurok\.so' "$PAM_FILE"; then echo "OK:ALREADY_PRESENT($SERVICE)"; return 0; fi
            local first_auth
            first_auth=$(grep -nE '^(auth[[:space:]]|@include[[:space:]])' "$PAM_FILE" | head -1 | cut -d: -f1)
            if [ -z "$first_auth" ]; then echo "ERROR:NO_AUTH_LINE($SERVICE)"; return 0; fi
            # polkit-1 的 timeout=10 是刻意压短的（模块默认 40s，见
            # pam/pam_immurok.c 的 DEFAULT_TIMEOUT_SEC），走厂商副本这条路时
            # 也要带上，不能因为换了代码路径就悄悄变回 40s。
            local line="$PAM_LINE"
            [ "$SERVICE" = "polkit-1" ] && line="$PAM_LINE timeout=10"
            sed -i "${first_auth}i\\${line}" "$PAM_FILE"
            if [ "$repaired" = "1" ]; then
                echo "OK:REPAIRED($SERVICE)"
            elif [ "$from_vendor" = "1" ]; then
                echo "OK:ADDED_FROM_VENDOR($SERVICE)"
            else
                echo "OK:ADDED($SERVICE)"
            fi
            ;;
        remove)
            if [ ! -f "$PAM_FILE" ]; then echo "OK:NOT_PRESENT($SERVICE)"; return 0; fi
            if ! grep -q 'pam_immurok\.so' "$PAM_FILE"; then echo "OK:NOT_PRESENT($SERVICE)"; return 0; fi
            # 整份文件是我们建的（polkit-1 模板，或厂商副本）→ 删文件，
            # 把该服务还原成发行版默认；只是我们插了一行的用户文件 → 只删行。
            if grep -q "$IMMUROK_MARKER" "$PAM_FILE"; then
                rm -f "$PAM_FILE"; echo "OK:REMOVED($SERVICE)"; return 0
            fi
            sed -i '/pam_immurok\.so/d' "$PAM_FILE"
            echo "OK:REMOVED($SERVICE)"
            ;;
        *) echo "ERROR:INVALID_ACTION"; return 0 ;;
    esac
}

if [ "$#" -eq 0 ]; then echo "ERROR:NO_SERVICE"; exit 1; fi
for s in "$@"; do process_one "$s"; done
exit 0
